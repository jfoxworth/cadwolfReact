generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model File {
  id           Int         @id @default(autoincrement())
  userId       Int         @map("user_id")
  teamId       Int?        @map("team_id")
  fileTypeId   String      @map("file_type_id")
  name         String
  itemData     String      @map("item_data")
  order        Int         @default(0)
  version      Int         @default(1)
  oid          Int         @default(0)
  revision     Int         @default(1)
  parentId     Int?        @map("parent_id")
  lft          Int         @map("_lft")
  rgt          Int         @map("_rgt")
  slug         String      @unique @default("")
  needsUpdate  Boolean     @default(false) @map("needs_update")
  storageBytes BigInt      @default(0) @map("storage_bytes")
  lockedBy     Int?        @map("locked_by")
  lockedAt     DateTime?   @map("locked_at")
  deletedAt    DateTime?   @map("deleted_at")
  createdAt    DateTime?   @map("created_at")
  updatedAt    DateTime?   @map("updated_at")
  components      Component[]
  bibliographies  Bibliography[]
  fileImports     FileImport[]
  datasetImports  DatasetImport[]
  versions        FileVersion[]
  partTreeEmbedding PartTreeEmbedding?

  @@map("files")
}

model FileVersion {
  id           Int      @id @default(autoincrement())
  fileId       Int      @map("file_id")
  partTreeId   Int?     @map("part_tree_id")   // set when this snapshot is part of a part tree snapshot; null for individual doc checkins
  version      Int                              // the version number at time of snapshot
  snapshotData String   @map("snapshot_data")  // JSON array of block content objects
  createdBy    Int      @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  file         File     @relation(fields: [fileId], references: [id])

  @@map("file_versions")
}


model Component {
  id              Int       @id @default(autoincrement())
  itemid          String?
  name            String?
  fileId          Int       @map("file_id")
  componentTypeId Int       @map("component_type_id")
  content         String?
  dependentId     String?   @map("dependent_id")
  dependentFile   String?   @map("dependent_file")
  order           Int       @default(999999)
  inEdit          Int       @default(1)
  version         Int       @default(1)
  // Mirrors content.isRequirement for TEXT/EQUATION/SYMBOLIC_EQUATION blocks (utils/requirementFlag.ts)
  isRequirement   Boolean   @default(false) @map("is_requirement")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime? @map("created_at")
  updatedAt       DateTime? @map("updated_at")
  file            File      @relation(fields: [fileId], references: [id])
  blockEmbeddings BlockEmbedding[]

  @@index([fileId, isRequirement])
  @@map("components")
}

// RAG embeddings: one or more chunks per Component (see utils/blockToText.ts's
// chunkTextBlock — most blocks are a single chunk; an oversized TEXT block can split into
// several). The vector column itself is Unsupported here since Prisma's query builder can't
// read/write it directly — all embedding reads/writes go through $queryRaw/$executeRaw.
// provider/model are recorded per row so a future provider switch is a clean, verifiable
// cutover (re-embed everything, confirm, then switch retrieval over) rather than silently
// mixing vectors from incompatible embedding spaces in the same similarity search.
model BlockEmbedding {
  id          Int       @id @default(autoincrement())
  componentId Int       @map("component_id")
  fileId      Int       @map("file_id")
  chunkIndex  Int       @default(0) @map("chunk_index")
  chunkText   String    @map("chunk_text")
  embedding   Unsupported("vector(1024)")
  provider    String    @default("voyage")
  model       String    @default("voyage-4-lite")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @map("updated_at")
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([componentId, chunkIndex])
  @@index([fileId])
  @@map("block_embeddings")
}

// One row per Part Tree — a structural-similarity embedding of the whole tree (name,
// description, subsystem/part hierarchy, and cross-document import wiring), recomputed
// whenever something inside the tree changes (see utils/embedPartTree.ts). Keyed by fileId
// directly, unlike BlockEmbedding, since a PartTree root has no Components of its own to key on.
model PartTreeEmbedding {
  id          Int      @id @default(autoincrement())
  fileId      Int      @unique @map("file_id")
  summaryText String   @map("summary_text")
  embedding   Unsupported("vector(1024)")
  provider    String   @default("voyage")
  model       String   @default("voyage-4-lite")
  updatedAt   DateTime @default(now()) @map("updated_at")
  file        File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("part_tree_embeddings")
}

model Bibliography {
  id        Int       @id @default(autoincrement())
  fileId    Int       @map("file_id")
  authors   String    @default("")
  title     String    @default("")
  year      Int?
  source    String?
  url       String?
  doi       String?
  note      String?
  order     Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  file      File      @relation(fields: [fileId], references: [id])

  @@map("bibliographies")
}

model FileImport {
  id                 Int       @id @default(autoincrement())
  fileId             Int       @map("file_id")
  sourceFileId       Int       @map("source_file_id")
  sourceFileName     String    @default("") @map("source_file_name")
  sourceVariableName String    @default("") @map("source_variable_name")
  localAlias         String    @default("") @map("local_alias")
  value              String?
  units              String?
  needsUpdate        Boolean   @default(false) @map("needs_update")
  order              Int       @default(0)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  file               File      @relation(fields: [fileId], references: [id])

  @@map("file_imports")
}

model DatasetImport {
  id             Int       @id @default(autoincrement())
  fileId         Int       @map("file_id")
  datasetId      Int       @map("dataset_id")
  datasetName    String    @default("") @map("dataset_name")
  localAlias     String    @default("") @map("local_alias")
  cachedValues   String?   @map("cached_values")   // JSON array string e.g. "[1,2,3]"
  datapointCount Int       @default(0) @map("datapoint_count")
  matrixSize     String?   @map("matrix_size")     // e.g. "4x354"
  needsUpdate    Boolean   @default(false) @map("needs_update")
  order          Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  file           File      @relation(fields: [fileId], references: [id])

  @@map("dataset_imports")
}

model User {
  id             Int       @id @default(autoincrement())
  name           String
  email          String    @unique
  password       String?
  username       String?   @unique
  currentTeamId  Int?      @map("current_team_id")
  photoUrl       String?   @map("photo_url")
  title          String?
  bio            String?
  organization   String?
  location       String?
  website        String?
  phone          String?
  // Tier: "free" | "pro"
  tier                 String    @default("free")
  // AI chat model preference: "haiku" | "sonnet" | "opus" (see utils/aiModels.ts); new users default to sonnet
  aiModel              String    @default("sonnet") @map("ai_model")
  // AI chat reasoning effort: "low" | "medium" | "high" | "xhigh" | "max" (see utils/aiModels.ts)
  aiEffort             String    @default("medium") @map("ai_effort")
  // Which pool AI use is charged to: null = this user's own credits, otherwise a team the user belongs to
  aiAccountTeamId      Int?      @map("ai_account_team_id")
  storageUsed          BigInt    @default(0) @map("storage_used")
  storageQuota         BigInt    @default(524288000) @map("storage_quota")  // 500 MB default
  emailVerifiedAt      DateTime? @map("email_verified_at")
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model CadConnection {
  id          Int       @id @default(autoincrement())
  documentId  String    @map("document_id")   // stored as string in DB (e.g. "24")
  cadId       String?   @map("cad_id")        // legacy cadids.id reference (unused in new flow)
  cadType     String    @default("onshape") @map("cad_type")  // "onshape" | "fusion"
  info        String    @default("{}")        // JSON: { workspace, document, element, equations[] }
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime? @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  @@map("connects")
}

model Team {
  id             Int          @id @default(autoincrement())
  name           String
  description    String       @default("")
  ownerId        Int          @map("owner_id")
  // Tier: "free" | "business"
  tier           String       @default("free")
  // Number of seats purchased (0 = no org license)
  seatCount      Int          @default(0) @map("seat_count")
  storageUsed    BigInt       @default(0) @map("storage_used")
  storageQuota   BigInt       @default(0) @map("storage_quota")  // set on upgrade
  billingEmail         String?      @map("billing_email")
  stripeCustomerId     String?      @map("stripe_customer_id")
  stripeSubscriptionId String?      @map("stripe_subscription_id")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  members              TeamMember[]
  invites              OrgInvite[]

  @@map("teams")
}

model TeamMember {
  teamId Int    @map("team_id")
  userId Int    @map("user_id")
  // role: "owner" | "admin" | "member"
  role   String @default("member")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

model OrgInvite {
  id          Int       @id @default(autoincrement())
  teamId      Int       @map("team_id")
  email       String
  // role to grant on acceptance: "admin" | "member"
  role        String    @default("member")
  token       String    @unique @default("")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("org_invites")
}

model FilePermission {
  id          Int      @id @default(autoincrement())
  fileId      Int      @map("file_id")
  subjectId   Int      @map("subject_id")
  subjectType String   @map("subject_type")
  level       String
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("file_permissions")
}

model OAuthAccount {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  provider          String    // "google" | "facebook" | "onshape" | "fusion"
  providerAccountId String?   @map("provider_account_id")
  accessToken       String    @map("access_token")
  refreshToken      String?   @map("refresh_token")
  expiresAt         DateTime? @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([userId, provider])
  @@map("oauth_accounts")
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model EmailChangeToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  newEmail  String   @map("new_email")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_change_tokens")
}

model Dataset {
  id          Int         @id @default(autoincrement())
  userId      Int         @map("user_id")
  teamId      Int?        @map("team_id")
  name        String
  description String
  order       Int         @default(999999)
  parentId    Int?        @map("parent_id")
  lft         Int         @map("_lft")
  rgt         Int         @map("_rgt")
  deletedAt   DateTime?   @map("deleted_at")
  createdAt   DateTime?   @map("created_at")
  updatedAt   DateTime?   @map("updated_at")
  datapoints  Datapoint[]

  @@map("datasets")
}

model Datapoint {
  id              Int       @id @default(autoincrement())
  datasetId       Int       @map("dataset_id")
  datapointTypeId Int       @map("datapoint_type_id")
  content         String
  order           Int       @default(999999)
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime? @map("created_at")
  updatedAt       DateTime? @map("updated_at")
  dataset         Dataset   @relation(fields: [datasetId], references: [id])

  @@map("datapoints")
}

// ── AI credits ───────────────────────────────────────────────────────────────
// Amounts are whole "units": 1 unit = one millionth of a dollar. 1 credit = $0.001 = 1,000 units.
// For any user: sum(AiCreditPurchase.units) - sum(AiUsageLog.costUnits) = sum(AiCreditBalance.remaining).

// One row per AI interaction (a chat request, a build, a part-tree build, a generated document).
model AiUsageLog {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  teamId           Int?     @map("team_id") // the team whose credits paid; null = the user's own
  pageType         String   @map("page_type") // document | dataset | workspace | part-tree
  fileId           Int?     @map("file_id")
  source           String   // chat | document_build | part_tree_build | generate_document
  model            String   // haiku | sonnet | opus
  inputTokens      Int      @default(0) @map("input_tokens")
  cacheReadTokens  Int      @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int      @default(0) @map("cache_write_tokens")
  outputTokens     Int      @default(0) @map("output_tokens")
  costUnits        BigInt   @map("cost_units")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([teamId, createdAt])
  @@index([fileId])
  @@map("ai_usage_log")
}

// One row per credit purchase or grant. `source` is not Stripe-specific: stripe | grant | manual.
model AiCreditPurchase {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")  // who bought or was granted it
  teamId      Int?     @map("team_id")  // set = a team's shared credits; null = the user's own
  units       BigInt
  source      String
  reference   String   // Stripe session id, "welcome:<userId>", ...
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  balance     AiCreditBalance?

  @@unique([source, reference])
  @@index([userId])
  @@index([teamId])
  @@map("ai_credit_purchases")
}

// How much is left of each purchase. Created with the purchase and reduced on every use.
model AiCreditBalance {
  id         Int              @id @default(autoincrement())
  purchaseId Int              @unique @map("purchase_id")
  userId     Int              @map("user_id")
  teamId     Int?             @map("team_id")
  remaining  BigInt
  updatedAt  DateTime         @updatedAt @map("updated_at")
  purchase   AiCreditPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([teamId])
  @@map("ai_credit_balances")
}

// Optional monthly spending cap for one member of a team, in units. No row = no cap.
model TeamAiLimit {
  id           Int      @id @default(autoincrement())
  teamId       Int      @map("team_id")
  userId       Int      @map("user_id")
  monthlyUnits BigInt   @map("monthly_units")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([teamId, userId])
  @@map("team_ai_limits")
}
